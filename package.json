{
    "name": "slot-game-service",
    "version": "1.0.0",
    "description": "",
    "main": "./src/app.js",
    "scripts": {
        "integration-test": "jest tests/integration-tests/index.test.js --ci --reporters=default --reporters=jest-junit --forceExit",
        "test": "jest --testPathPattern=tests/unit-tests/",
        "test-coverage": "jest --testPathPattern=tests/unit-tests/ --collect-coverage",
        "dev": "set APP_NAME=summerheat&& nodemon --import=extensionless/register --watch ./src ./src/app.js",
        "debug": "set APP_NAME=slot_servive && nodemon --import=extensionless/register --watch ./ --inspect ./src/app.js",
        "prod": "node --import=extensionless/register --max-old-space-size=8192 ./src/app.js",
        "reg": "npm set registry https://npm.lumigame.com",
        "prepare-husky": "husky"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "author": "pentagon",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "extensionless": "^1.9.9",
        "mongoose": "6.13.8",
        "sc-slot-game-base": "3.3.0-beta.2"
    },
    "overrides": {
        "mongoose": "6.13.8",
        "mongoose-long": "0.8.0"
    },
    "resolutions": {
        "socket.io-prom-metrics": "1.0.3"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.11.5",
        "@commitlint/cli": "19.8.1",
        "@commitlint/config-conventional": "19.8.1",
        "babel-jest": "29.7.0",
        "babel-plugin-rewire": "^1.2.0",
        "husky": "9.1.7",
        "jest": "^29.0.0",
        "jest-extended": "^4.0.2",
        "jest-html-reporters": "^3.1.1",
        "jest-junit": "^12.2.0",
        "jest-micro-auto-stub": "1.0.9",
        "jest-sonar-reporter": "^2.0.0",
        "nodemon": "^2.0.4",
        "sc-game-service-integration-utils": "2.3.0"
    }
}
