{
    "name": "slot-game-service",
    "version": "1.0.0",
    "description": "",
    "main": "./src/app.js",
    "scripts": {
        "integration-test": "jest tests/integration-tests/index.test.js --ci --reporters=default --reporters=jest-junit --forceExit",
        "test": "jest --testPathPattern=tests/unit-tests/",
        "test-coverage": "jest --testPathPattern=tests/unit-tests/ --collect-coverage",
        "dev": "set APP_NAME=slot_servive && nodemon --es-module-specifier-resolution=node --watch ./src ./src/app.js",
        "debug": "set APP_NAME=slot_servive && nodemon --es-module-specifier-resolution=node --watch ./ --inspect ./src/app.js",
        "prod": "node --max-old-space-size=8192 --es-module-specifier-resolution=node ./src/app.js",
        "reg": "npm set registry http://npm.lumigame.com"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "author": "pentagon",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "sc-slot-game-base": "2.0.0"
    },
    "resolutions": {
        "sc-base-apis": "1.18.2"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.11.5",
        "@commitlint/cli": "^9.1.2",
        "@commitlint/config-conventional": "^9.1.2",
        "babel-jest": "^26.6.0",
        "babel-plugin-rewire": "^1.2.0",
        "husky": "^4.2.5",
        "install": "^0.13.0",
        "jest": "^26.6.3",
        "jest-extended": "^0.11.5",
        "jest-html-reporters": "^3.1.1",
        "jest-junit": "^12.2.0",
        "jest-micro-auto-stub": "^1.0.6",
        "jest-sonar-reporter": "^2.0.0",
        "nodemon": "^2.0.4",
        "sc-game-service-integration-utils": "1.3.7"
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    }
}
